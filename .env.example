# Copy to .env and fill in your values. Never commit .env!

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres (pgvector)
# Local Docker Compose default:
DATABASE_URL=postgresql+asyncpg://compass:compass@localhost:5432/compass
# For Neon/Supabase, paste your postgres:// or postgresql:// URL (SSL handled automatically)

# LLM Provider: "anthropic" (Claude), "groq" (free tier), or "gemini" (free tier)
# Change provider or model in one place without touching code:
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_MEMORY_MODEL=

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MEMORY_MODEL=claude-haiku-4-5-20251001

# Free-tier alternatives (optional — set LLM_PROVIDER=groq or LLM_PROVIDER=gemini)
GROQ_API_KEY=
GEMINI_API_KEY=

# Local embeddings (fastembed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=.fastembed_cache

# Ranking weights (must sum to 1.0)
RANK_WEIGHT_SEMANTIC=0.50
RANK_WEIGHT_SKILL_OVERLAP=0.25
RANK_WEIGHT_PREFERENCE_FIT=0.15
RANK_WEIGHT_FRESHNESS=0.10

# Rate limiting
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_DEFAULT=120/minute
